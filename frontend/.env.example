# Local development: leave empty to use Vite's /api proxy to localhost:3001.
VITE_API_BASE_URL=

# For a separately hosted frontend, set this in the hosting environment before
# building (origin only, with no trailing slash or /api suffix):
# VITE_API_BASE_URL=https://open-ride-app-api.vercel.app
# VITE_ values are public. Never put API keys or passwords here.
